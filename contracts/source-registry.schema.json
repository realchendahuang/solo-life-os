{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X-Tiller Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sources"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_url",
          "source_type",
          "fetch_mode",
          "pillars",
          "priority",
          "cadence",
          "event_filters",
          "enabled",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_type": {
            "enum": [
              "official-changelog",
              "official-blog",
              "github-releases",
              "rss",
              "community-feedback",
              "personal-evidence"
            ]
          },
          "fetch_mode": {
            "enum": [
              "web-search",
              "github-releases",
              "rss",
              "manual"
            ]
          },
          "pillars": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "cadence": {
            "enum": [
              "on-demand",
              "daily",
              "weekly"
            ]
          },
          "event_filters": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
